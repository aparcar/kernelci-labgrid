# KernelCI Labgrid Agent - Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   vim .env

# Required: Your KernelCI API token
KCI_API_TOKEN=your-kernelci-api-token-here

# Optional: KernelCI API URL (default: production)
# KCI_API_URL=https://api.kernelci.org

# Optional: Lab name (default: openwrt-qemu-lab)
# LAB_NAME=my-custom-lab-name
