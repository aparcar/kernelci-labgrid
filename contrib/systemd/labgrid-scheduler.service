[Unit]
Description=KernelCI Labgrid Push Scheduler
Documentation=https://github.com/kernelci/kernelci-labgrid
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kernelci
Group=kernelci

# Configuration
Environment="KCI_API_URL=https://api.kernelci.org"
EnvironmentFile=-/etc/kernelci/labgrid-scheduler.env

# Working directory
WorkingDirectory=/opt/kernelci-labgrid

# Start command
ExecStart=/usr/local/bin/labgrid-scheduler \
    --config /etc/kernelci/labgrid-runtime.yaml \
    --scheduler-config /etc/kernelci/labgrid-scheduler.yaml \
    --workers 4

# Restart policy
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=labgrid-scheduler

[Install]
WantedBy=multi-user.target
