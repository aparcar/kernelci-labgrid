# ============ Baseline Tests ============
{% if test_suite == 'baseline' %}

class TestBaseline:
    """Basic boot and system verification tests."""

    def test_login(self, shell):
        """Verify system is accessible and login works."""
        stdout, stderr, exitcode = shell.run("whoami")
        assert exitcode == 0, f"Login failed: {stderr}"
        logger.info(f"Logged in as: {stdout[0].strip()}")

    def test_kernel_version(self, shell):
        """Verify kernel version matches expected."""
        stdout, stderr, exitcode = shell.run("uname -r")
        assert exitcode == 0, f"Failed to get kernel version: {stderr}"

        kernel = stdout[0].strip()
        logger.info(f"Kernel version: {kernel}")

{% if kernel_version %}
        assert "{{ kernel_version }}" in kernel, \
            f"Kernel mismatch: expected '{{ kernel_version }}' in '{kernel}'"
{% endif %}

    def test_kernel_messages(self, shell):
        """Check for critical kernel errors."""
        stdout, stderr, exitcode = shell.run(
            "dmesg | grep -iE '(error|panic|oops|bug|warning)' | grep -v 'error=0' | head -20"
        )

        # exitcode 1 means no matches found (good)
        if exitcode == 0 and stdout:
            errors = '\n'.join(stdout)
            logger.warning(f"Kernel messages found:\n{errors}")
            # Only fail on critical errors, not warnings
            assert not any(x in errors.lower() for x in ['panic', 'oops', 'bug:']), \
                f"Critical kernel errors detected:\n{errors}"

    def test_device_tree(self, shell):
        """Verify device tree compatible strings."""
{% if compatible %}
        stdout, stderr, exitcode = shell.run(
            "cat /proc/device-tree/compatible | tr '\\0' '\\n'"
        )
        assert exitcode == 0, f"Failed to read device tree: {stderr}"

        dt_compatible = '\n'.join(stdout)
        logger.info(f"Device tree compatible:\n{dt_compatible}")

    {% for compat in compatible %}
        assert "{{ compat }}" in dt_compatible, \
            f"Missing compatible string: {{ compat }}"
    {% endfor %}
{% else %}
        pytest.skip("No compatible strings configured")
{% endif %}

    def test_cpu_online(self, shell):
        """Verify all CPUs are online."""
        stdout, stderr, exitcode = shell.run(
            "cat /sys/devices/system/cpu/online"
        )
        assert exitcode == 0, f"Failed to read CPU status: {stderr}"

        online = stdout[0].strip()
        logger.info(f"Online CPUs: {online}")

    def test_memory(self, shell):
        """Verify memory is accessible."""
        stdout, stderr, exitcode = shell.run("free -m")
        assert exitcode == 0, f"Failed to read memory: {stderr}"

        logger.info(f"Memory info:\n{''.join(stdout)}")


